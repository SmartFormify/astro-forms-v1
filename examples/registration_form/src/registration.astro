---
const endpointUrl = "https://api.smartformify.com/fe/YOUR_ENDPOINT_KEY";
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>Event registration</title><link rel="stylesheet" href="./style.css" /></head><body><main class="registration-page"><section class="registration-card"><header class="form-header"><h1>Event registration</h1><p>Reserve a place. This form does not create an account or collect credentials.</p></header><form action={endpointUrl} method="POST" class="registration-form"><div class="form-row"><label class="form-group" for="first_name">First name<input id="first_name" name="first_name" required /></label><label class="form-group" for="last_name">Last name<input id="last_name" name="last_name" required /></label></div><label class="form-group" for="email">Email address<input id="email" name="email" type="email" required /></label><label class="form-group" for="event">Event<select id="event" name="event" required><option value="">Choose an event</option><option>Product workshop</option><option>Community meetup</option></select></label><label class="form-group" for="accessibility_notes">Accessibility or dietary notes<textarea id="accessibility_notes" name="accessibility_notes"></textarea></label><label class="terms-group"><input type="checkbox" name="updates" value="yes" /> Send me occasional event updates.</label><button type="submit" class="submit-button">Register for event</button></form></section></main></body></html>
